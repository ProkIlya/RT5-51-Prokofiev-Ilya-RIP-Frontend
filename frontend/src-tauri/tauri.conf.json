{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tesla Charge Calculator",
  "version": "0.1.0",
  "identifier": "com.tesla.chargecalculator",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "height": 700,
        "resizable": true,
        "title": "Tesla Charge Calculator",
        "width": 1000
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: http: https: ws: wss:; connect-src 'self' http://192.168.56.1:8080 http://localhost:8080;",
      "capabilities": ["default"]
    }
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://192.168.56.1:3000"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "",
    "longDescription": ""
  },
  "plugins": {
    "http": {
      "enabled": true,
      "scope": [
        "http://192.168.56.1:8080/**",
        "http://192.168.56.1:9000/**"
      ]
    }
  }
}