{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tesla Charge Calculator",
  "version": "0.1.0",
  "identifier": "com.tesla.charge.calc5",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "height": 400,
        "resizable": true,
        "title": "Tesla Charge Calculator",
        "width": 600
        
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "https://192.168.56.1:3000"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.ico"
    ]
  }
}